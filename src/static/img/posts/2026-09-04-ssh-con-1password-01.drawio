<mxfile host="Electron">
  <diagram name="Autenticación SSH con clave pública" id="diagram-1">
    <mxGraphModel dx="1237" dy="662" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n-srv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Servidor SSH&lt;/b&gt; (remoto)&lt;br&gt;sshd · authorized_keys&lt;br&gt;&lt;font&gt;solo tiene claves públicas&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="680" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n-cli" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Cliente SSH&lt;/b&gt;&lt;br&gt;ssh · scp · git&lt;br&gt;&lt;font&gt;tiene la clave privada (en un fichero o en un agente)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="680" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="n-cli" target="n-srv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;fontSize=11;startArrow=classic;endArrow=classic;exitX=0.08;exitY=0;exitDx=0;exitDy=0;entryX=0.08;entryY=1;entryDx=0;entryDy=0;" value="① canal cifrado&lt;br&gt;identificador&lt;br&gt;de sesión">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n-cli" target="n-srv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;html=1;fontSize=11;exitX=0.26;exitY=0;exitDx=0;exitDy=0;entryX=0.26;entryY=1;entryDx=0;entryDy=0;" value="② ¿aceptas esta&lt;br&gt;clave pública?">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-22" y="-45" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2loop" edge="1" parent="1" source="n-srv" target="n-cli" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;html=1;fontSize=11;dashed=1;strokeColor=#9e9e9e;fontColor=#616161;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;" value="✗ no la acepto:&lt;br&gt;prueba la siguiente&lt;br&gt;(hasta n veces)">
