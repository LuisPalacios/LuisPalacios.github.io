        <mxCell id="s7" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#6A1B9A;fontSize=12;fontStyle=1;verticalAlign=bottom;" value="7.  Si PAUSAS:  un paquetito de 3 bytes cada 60 segundos">
