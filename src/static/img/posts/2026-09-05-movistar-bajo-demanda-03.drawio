        </mxCell>
        <mxCell id="s1" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#607D8B;fontSize=12;verticalAlign=bottom;align=center;" value="1.  &quot;¿Quién sirve esto?&quot;  (consulta al DNS)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="175" y="165" as="sourcePoint" />
            <mxPoint x="925" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=2.5;strokeColor=#1565C0;fontSize=12;fontStyle=1;verticalAlign=bottom;" value="2.  SETUP:  &quot;mándame el vídeo al puerto 27392&quot;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="175" y="245" as="sourcePoint" />
            <mxPoint x="925" y="245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;fontStyle=2;" value="El ayudante lee esta línea al pasar" vertex="1">
          <mxGeometry height="30" width="220" x="440" y="255" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;" value="3.  APUNTA:  &quot;va a llegar un vídeo al 27392 desde ESTE OTRO servidor — déjalo pasar&quot;" vertex="1">
          <mxGeometry height="52" width="380" x="360" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;fontSize=11;fontColor=#2E7D32;" value="Esto es la &quot;expectativa&quot;.&#xa;Dura 5 minutos y sirve UNA sola vez." vertex="1">
          <mxGeometry height="44" width="260" x="755" y="313" as="geometry" />
        </mxCell>
        <mxCell id="s4" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=2.5;strokeColor=#455A64;fontSize=12;verticalAlign=bottom;" value="4.  Respuesta:  &quot;de acuerdo — y yo emito desde el puerto 49980&quot;">
