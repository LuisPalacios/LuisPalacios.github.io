        <mxCell id="s6" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#78909C;dashed=1;fontSize=12;verticalAlign=bottom;" value="6.  &quot;sigo aquí&quot;  (GET_PARAMETER, de vez en cuando)">
