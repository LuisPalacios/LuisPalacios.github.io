        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;" value="El ayudante lo reconoce, gasta la anotación&#xa;y lo encamina hasta el deco.   Se ve la imagen." vertex="1">
          <mxGeometry height="42" width="320" x="390" y="513" as="geometry" />
