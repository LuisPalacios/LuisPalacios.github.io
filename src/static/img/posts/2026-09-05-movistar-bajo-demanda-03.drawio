        <mxCell id="s8" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#607D8B;fontSize=12;verticalAlign=bottom;" value="8.  TEARDOWN:  &quot;he terminado&quot;">
