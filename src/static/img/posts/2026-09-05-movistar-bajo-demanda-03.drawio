        <mxCell id="s5" edge="1" parent="1" style="html=1;endArrow=classic;strokeWidth=5;strokeColor=#E65100;fontSize=13;fontStyle=1;verticalAlign=bottom;" value="5.  EL VÍDEO  (MPEG-TS por UDP, sin parar)">
