        <mxCell id="key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;dashed=1;fontSize=12;align=left;spacingLeft=12;" value="Lo importante: en el paso 2 el puerto se dice HABLANDO. Sin el ayudante, en el paso 5 nadie sabría qué hacer con ese vídeo." vertex="1">
