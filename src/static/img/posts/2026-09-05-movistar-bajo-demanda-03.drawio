        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=11;" value="Mantiene la puerta abierta mientras no llega vídeo.&#xa;Por eso puedes pausar lo que quieras." vertex="1">
          <mxGeometry height="40" width="380" x="360" y="683" as="geometry" />
